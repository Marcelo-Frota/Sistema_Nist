@model IEnumerable<NistCsfMaturitySystem.Models.Usuario>

@{
    ViewData["Title"] = "Administração de Usuários";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><span class="text-danger">|</span> @ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-cptm-primary"><i class="fas fa-plus"></i> Novo Usuário</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Perfil</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle fw-bold">@item.Nome</td>
                        <td class="align-middle">@item.Email</td>
                        <td class="align-middle">
                            <span class="badge bg-secondary">@item.Perfil.Nome</span>
                        </td>
                        <td class="align-middle">
                            @if(item.Status == "ATIVO") {
                                <span class="badge bg-success">@item.Status</span>
                            } else {
                                <span class="badge bg-danger">@item.Status</span>
                            }
                        </td>
                        <td class="text-end align-middle">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
