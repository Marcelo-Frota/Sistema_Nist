@model NistCsfMaturitySystem.ViewModels.CenarioAlvoViewModel

@{
    ViewData["Title"] = "Cenário Atual (Vigente)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title text-success">
        <i class="bi bi-shield-check"></i> @Model.Cenario.Nome
        @if(Model.Cenario.Id != 0) {
            <span class="badge bg-success fs-6 ms-2">VIGENTE</span>
        }
    </h2>
    <span class="text-muted">Efetivado em: @(Model.Cenario.DataEfetivacao?.ToString("dd/MM/yyyy") ?? "N/A")</span>
</div>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info">@ViewBag.Message</div>
}

@if (Model.Funcoes != null && Model.Funcoes.Any())
{
    <p class="text-muted">Compare as Metas do Alvo com a realidade da sua empresa hoje. Registre o progresso e as evidências.</p>

    <div class="accordion" id="accordionNistAtual">
        @foreach (var funcao in Model.Funcoes)
        {
            <div class="accordion-item mb-3 border-0 shadow-sm">
                <h2 class="accordion-header" id="heading_@funcao.Codigo">
                    <button class="accordion-button collapsed fw-bold text-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@funcao.Codigo" style="background-color: @funcao.Cor; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">
                        @funcao.Codigo - @funcao.Nome
                    </button>
                </h2>
                <div id="collapse_@funcao.Codigo" class="accordion-collapse collapse" data-bs-parent="#accordionNistAtual">
                    <div class="accordion-body p-0">
                        
                        @foreach (var categoria in funcao.Categorias)
                        {
                            <div class="bg-light p-3 border-bottom border-2 border-white">
                                <h5 class="text-dark fw-bold mb-1">@categoria.Codigo - @categoria.Nome</h5>
                                <p class="small text-muted mb-3">@categoria.Descricao</p>

                                <div class="list-group">
                                    @foreach (var subcat in categoria.Subcategorias)
                                    {
                                        var badgeColor = subcat.Avaliacao?.StatusAtual switch {
                                            "ATENDIDO" => "bg-success",
                                            "RAZOAVELMENTE_ATENDIDO" => "bg-info text-dark",
                                            "PARCIALMENTE_ATENDIDO" => "bg-warning text-dark",
                                            "DEFICITARIAMENTE_ATENDIDO" => "bg-danger",
                                            "NAO_ATENDIDO" => "bg-dark",
                                            _ => "bg-secondary"
                                        };

                                        <div class="list-group-item list-group-item-action flex-column align-items-start">
                                            <div class="d-flex w-100 justify-content-between mb-2">
                                                <h6 class="mb-1 fw-bold">@subcat.Codigo</h6>
                                                <span class="badge @badgeColor" id="badge_status_@subcat.Id">
                                                    @(string.IsNullOrEmpty(subcat.Avaliacao?.StatusAtual) ? "STATUS PENDENTE" : subcat.Avaliacao.StatusAtual.Replace("_", " "))
                                                </span>
                                            </div>
                                            <p class="mb-3 small">@subcat.Descricao</p>

                                            <!-- Card Comparativo: Alvo (Bloqueado) vs Atual (Editável) -->
                                            <div class="row g-3">
                                                
                                                <!-- BLOCO ESQUERDO: METAS (ALVO) - Somente Leitura -->
                                                <div class="col-md-6 border-end">
                                                    <h6 class="text-primary fw-bold mb-3"><i class="bi bi-bullseye"></i> Metas Definidas no Alvo</h6>
                                                    <div class="row g-2 small">
                                                        <div class="col-6"><strong>Prioridade:</strong> @subcat.Avaliacao?.PrioridadeAlvo</div>
                                                        <div class="col-6"><strong>Tier CSF:</strong> @subcat.Avaliacao?.TierAlvo</div>
                                                        <div class="col-12 mt-2"><strong>Políticas/Processos:</strong><br/> <span class="text-muted">@(string.IsNullOrEmpty(subcat.Avaliacao?.PoliticasAlvo) ? "-" : subcat.Avaliacao.PoliticasAlvo)</span></div>
                                                        <div class="col-12 mt-2"><strong>Práticas Internas:</strong><br/> <span class="text-muted">@(string.IsNullOrEmpty(subcat.Avaliacao?.PraticasAlvo) ? "-" : subcat.Avaliacao.PraticasAlvo)</span></div>
                                                        <div class="col-12 mt-2"><strong>Papéis e Resp.:</strong><br/> <span class="text-muted">@(string.IsNullOrEmpty(subcat.Avaliacao?.ResponsabilidadesAlvo) ? "-" : subcat.Avaliacao.ResponsabilidadesAlvo)</span></div>
                                                        <div class="col-12 mt-2"><strong>Ref. Informativas:</strong><br/> <span class="text-muted">@(string.IsNullOrEmpty(subcat.Avaliacao?.ReferenciasAlvo) ? "-" : subcat.Avaliacao.ReferenciasAlvo)</span></div>
                                                    </div>
                                                </div>

                                                <!-- BLOCO DIREITO: REALIDADE (ATUAL) - Editável -->
                                                <div class="col-md-6">
                                                    <h6 class="text-success fw-bold mb-3"><i class="bi bi-activity"></i> Realidade Atual (Preenchimento)</h6>
                                                    
                                                    <div class="row g-2 align-items-start">
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-bold">Status Atual</label>
                                                            <select class="form-select form-select-sm mb-2" id="status_atual_@subcat.Id">
                                                                <option value="">Selecione...</option>
                                                                <option value="NAO_ATENDIDO" selected="@(subcat.Avaliacao?.StatusAtual == "NAO_ATENDIDO")">Não Atendido</option>
                                                                <option value="DEFICITARIAMENTE_ATENDIDO" selected="@(subcat.Avaliacao?.StatusAtual == "DEFICITARIAMENTE_ATENDIDO")">Deficitariamente</option>
                                                                <option value="PARCIALMENTE_ATENDIDO" selected="@(subcat.Avaliacao?.StatusAtual == "PARCIALMENTE_ATENDIDO")">Parcialmente</option>
                                                                <option value="RAZOAVELMENTE_ATENDIDO" selected="@(subcat.Avaliacao?.StatusAtual == "RAZOAVELMENTE_ATENDIDO")">Razoavelmente</option>
                                                                <option value="ATENDIDO" selected="@(subcat.Avaliacao?.StatusAtual == "ATENDIDO")">Atendido</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-bold">Prioridade Atual</label>
                                                            <select class="form-select form-select-sm mb-2" id="prioridade_atual_@subcat.Id">
                                                                <option value="">Selecione...</option>
                                                                <option value="BAIXA" selected="@(subcat.Avaliacao?.PrioridadeAtual == "BAIXA")">Baixa</option>
                                                                <option value="MEDIA" selected="@(subcat.Avaliacao?.PrioridadeAtual == "MEDIA")">Média</option>
                                                                <option value="ALTA" selected="@(subcat.Avaliacao?.PrioridadeAtual == "ALTA")">Alta</option>
                                                            </select>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-bold">Políticas/Processos Atuais</label>
                                                            <textarea class="form-control form-control-sm mb-2" id="politicas_atual_@subcat.Id" rows="2">@subcat.Avaliacao?.PoliticasAtual</textarea>

                                                            <label class="form-label small fw-bold">Práticas Internas Atuais</label>
                                                            <textarea class="form-control form-control-sm mb-2" id="praticas_atual_@subcat.Id" rows="2">@subcat.Avaliacao?.PraticasAtual</textarea>
                                                        </div>

                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-bold">Papéis e Resp. Atuais</label>
                                                            <textarea class="form-control form-control-sm mb-2" id="responsabilidades_atual_@subcat.Id" rows="2">@subcat.Avaliacao?.ResponsabilidadesAtual</textarea>
                                                            
                                                            <label class="form-label small fw-bold">Ref. Informativas Atuais</label>
                                                            <textarea class="form-control form-control-sm mb-2" id="referencias_atual_@subcat.Id" rows="2">@subcat.Avaliacao?.ReferenciasAtual</textarea>
                                                        </div>

                                                        <div class="col-md-12">
                                                            <label class="form-label small fw-bold text-success">Artefatos e Evidências (Provas)</label>
                                                            <textarea class="form-control form-control-sm mb-2 border-success" id="evidencias_atual_@subcat.Id" rows="2" placeholder="Descreva as evidências que provam que a meta foi atingida...">@subcat.Avaliacao?.EvidenciasAtual</textarea>
                                                        </div>
                                                    </div>

                                                    <div class="text-end mt-2">
                                                        <button class="btn btn-sm btn-success px-4" onclick="salvarAtual(@Model.Cenario.Id, @subcat.Id)">
                                                            <span id="spinner_atual_@subcat.Id" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                                            Salvar Progresso Atual
                                                        </button>
                                                    </div>

                                                </div>
                                            </div>

                                        </div>
                                    }
                                </div>

                            </div>
                        }
                        
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        async function salvarAtual(cenarioId, subcategoriaId) {
            const status = document.getElementById(`status_atual_${subcategoriaId}`).value;
            const prioridade = document.getElementById(`prioridade_atual_${subcategoriaId}`).value;
            const politicas = document.getElementById(`politicas_atual_${subcategoriaId}`).value;
            const praticas = document.getElementById(`praticas_atual_${subcategoriaId}`).value;
            const responsabilidades = document.getElementById(`responsabilidades_atual_${subcategoriaId}`).value;
            const referencias = document.getElementById(`referencias_atual_${subcategoriaId}`).value;
            const evidencias = document.getElementById(`evidencias_atual_${subcategoriaId}`).value;
            
            const spinner = document.getElementById(`spinner_atual_${subcategoriaId}`);
            const badge = document.getElementById(`badge_status_${subcategoriaId}`);
            
            spinner.classList.remove('d-none');

            const payload = {
                CenarioId: cenarioId,
                SubcategoriaId: subcategoriaId,
                StatusAtual: status,
                PrioridadeAtual: prioridade,
                PoliticasAtual: politicas,
                PraticasAtual: praticas,
                ResponsabilidadesAtual: responsabilidades,
                ReferenciasAtual: referencias,
                EvidenciasAtual: evidencias
            };

            try {
                const response = await fetch('@Url.Action("SalvarAtual", "Cenario")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (result.success) {
                    badge.innerText = status ? status.replace('_', ' ') : "SALVO";
                    
                    // Ajusta a cor do badge baseado no status salvo
                    badge.className = 'badge';
                    if(status === 'ATENDIDO') badge.classList.add('bg-success');
                    else if(status === 'PARCIALMENTE_ATENDIDO') badge.classList.add('bg-warning', 'text-dark');
                    else if(status === 'DEFICITARIAMENTE_ATENDIDO') badge.classList.add('bg-danger');
                    else if(status === 'NAO_ATENDIDO') badge.classList.add('bg-dark');
                    else badge.classList.add('bg-secondary');

                    const btn = spinner.parentElement;
                    const originalText = btn.innerHTML;
                    btn.innerHTML = `<i class="bi bi-check2"></i> Salvo com Sucesso!`;
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        document.getElementById(`spinner_atual_${subcategoriaId}`).classList.add('d-none');
                    }, 2000);
                } else {
                    alert("Erro: " + result.message);
                    spinner.classList.add('d-none');
                }
            } catch (error) {
                alert("Falha na comunicação.");
                spinner.classList.add('d-none');
            }
        }
    </script>
}
