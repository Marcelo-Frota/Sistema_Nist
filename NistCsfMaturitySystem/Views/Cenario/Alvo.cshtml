@model NistCsfMaturitySystem.ViewModels.CenarioAlvoViewModel

@{
    ViewData["Title"] = "Edição do Cenário Alvo";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-title">
        @Model.Cenario.Nome 
        <span class="badge @(Model.Cenario.Status == "PENDENTE_APROVACAO" ? "bg-warning text-dark" : "bg-secondary") fs-6 ms-2">
            @(Model.Cenario.Status == "PENDENTE_APROVACAO" ? "PENDENTE DE APROVAÇÃO" : Model.Cenario.Status)
        </span>
    </h2>
    @if (Model.Cenario.Status == "EM_ELABORACAO")
    {
        <button class="btn btn-success" onclick="solicitarAprovacao(@Model.Cenario.Id)">
            <span id="btnSubmitSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
            Solicitar Efetivação Geral
        </button>
    }
    else if (Model.Cenario.Status == "PENDENTE_APROVACAO")
    {
        <a href="@Url.Action("Revisar", "Aprovacao")" class="btn btn-warning fw-bold">
            <i class="bi bi-shield-check"></i> Ir para Revisar Baseline
        </a>
    }
</div>

@if (Model.Cenario.Status == "PENDENTE_APROVACAO")
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-4 border-warning shadow-sm">
        <div>
            <strong>Aguardando Revisão da Baseline:</strong> Este Cenário Alvo possui metas submetidas para aprovação. O Administrador deve acessar a aba <strong>Revisar Baseline</strong> para aprovar formalmente antes que entrem em vigor no Cenário Atual.
        </div>
        <a href="@Url.Action("Revisar", "Aprovacao")" class="btn btn-sm btn-dark">Revisar Baseline</a>
    </div>
}

<p class="text-muted">Preencha as metas (Alvo/Target) para cada subcategoria. Esta tela define ONDE A EMPRESA QUER CHEGAR.</p>

<div class="accordion" id="accordionNist">
    @foreach (var funcao in Model.Funcoes)
    {
        <div class="accordion-item mb-3 border-0 shadow-sm">
            <h2 class="accordion-header" id="heading_@funcao.Codigo">
                <button class="accordion-button collapsed fw-bold text-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@funcao.Codigo" style="background-color: @funcao.Cor; text-shadow: 1px 1px 2px rgba(0,0,0,0.5);">
                    @funcao.Codigo - @funcao.Nome
                </button>
            </h2>
            <div id="collapse_@funcao.Codigo" class="accordion-collapse collapse" data-bs-parent="#accordionNist">
                <div class="accordion-body p-0">
                    
                    @foreach (var categoria in funcao.Categorias)
                    {
                        <div class="bg-light p-3 border-bottom border-2 border-white">
                            <h5 class="text-dark fw-bold mb-1">@categoria.Codigo - @categoria.Nome</h5>
                            <p class="small text-muted mb-3">@categoria.Descricao</p>

                            <div class="list-group">
                                @foreach (var subcat in categoria.Subcategorias)
                                {
                                    <div class="list-group-item list-group-item-action flex-column align-items-start">
                                        <div class="d-flex w-100 justify-content-between mb-2">
                                            <h6 class="mb-1 fw-bold">@subcat.Codigo</h6>
                                            @if (Model.Cenario.Status == "PENDENTE_APROVACAO" && !string.IsNullOrEmpty(subcat.Avaliacao?.TierAlvo))
                                            {
                                                <span class="badge bg-warning text-dark" id="badge_status_@subcat.Id">PENDENTE DE APROVAÇÃO</span>
                                            }
                                            else if (!string.IsNullOrEmpty(subcat.Avaliacao?.TierAlvo))
                                            {
                                                <span class="badge bg-success" id="badge_status_@subcat.Id">ALVO DEFINIDO</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary" id="badge_status_@subcat.Id">METAS PENDENTES</span>
                                            }
                                        </div>
                                        <p class="mb-3 small">@subcat.Descricao</p>
                                        
                                        <!-- Formulário Alvo -->
                                        <div class="row g-2 align-items-start bg-white p-3 border rounded shadow-sm">
                                            
                                            <!-- Coluna 1: Combos -->
                                            <div class="col-md-2">
                                                <label class="form-label small fw-bold">Prioridade Alvo</label>
                                                <select class="form-select form-select-sm mb-2" id="prioridade_alvo_@subcat.Id">
                                                    <option value="">Selecione...</option>
                                                    <option value="BAIXA" selected="@(subcat.Avaliacao?.PrioridadeAlvo == "BAIXA")">Baixa</option>
                                                    <option value="MEDIA" selected="@(subcat.Avaliacao?.PrioridadeAlvo == "MEDIA")">Média</option>
                                                    <option value="ALTA" selected="@(subcat.Avaliacao?.PrioridadeAlvo == "ALTA")">Alta</option>
                                                </select>

                                                <label class="form-label small fw-bold">Tier CSF Alvo</label>
                                                <select class="form-select form-select-sm" id="tier_alvo_@subcat.Id">
                                                    <option value="">Selecione...</option>
                                                    <option value="TIER_1" selected="@(subcat.Avaliacao?.TierAlvo == "TIER_1")">Tier 1: Parcial</option>
                                                    <option value="TIER_2" selected="@(subcat.Avaliacao?.TierAlvo == "TIER_2")">Tier 2: Informado</option>
                                                    <option value="TIER_3" selected="@(subcat.Avaliacao?.TierAlvo == "TIER_3")">Tier 3: Repetível</option>
                                                    <option value="TIER_4" selected="@(subcat.Avaliacao?.TierAlvo == "TIER_4")">Tier 4: Adaptável</option>
                                                </select>
                                            </div>

                                            <!-- Coluna 2: Textos Alvo 1 -->
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold">Políticas e Processos Alvo</label>
                                                <textarea class="form-control form-control-sm mb-2" id="politicas_alvo_@subcat.Id" rows="2" placeholder="Ex: Criar política X">@subcat.Avaliacao?.PoliticasAlvo</textarea>

                                                <label class="form-label small fw-bold">Práticas Internas Alvo</label>
                                                <textarea class="form-control form-control-sm" id="praticas_alvo_@subcat.Id" rows="2" placeholder="Ex: Implementar ferramenta Y">@subcat.Avaliacao?.PraticasAlvo</textarea>
                                            </div>

                                            <!-- Coluna 3: Textos Alvo 2 -->
                                            <div class="col-md-3">
                                                <label class="form-label small fw-bold">Papéis e Responsab. Alvo</label>
                                                <textarea class="form-control form-control-sm mb-2" id="responsabilidades_alvo_@subcat.Id" rows="2" placeholder="Ex: CISO, Red Team">@subcat.Avaliacao?.ResponsabilidadesAlvo</textarea>

                                                <label class="form-label small fw-bold">Ref. Informativas Alvo</label>
                                                <textarea class="form-control form-control-sm" id="referencias_alvo_@subcat.Id" rows="2" placeholder="Ex: ISO 27001, COBIT">@subcat.Avaliacao?.ReferenciasAlvo</textarea>
                                            </div>

                                            <!-- Coluna 4: Botões -->
                                            <div class="col-md-4 text-end d-flex flex-column justify-content-end align-items-end">
                                                <button class="btn btn-sm btn-cptm w-100 mb-2" style="height: 38px;" onclick="salvarAlvo(@Model.Cenario.Id, @subcat.Id)" title="Salva as metas no Cenário Alvo">
                                                    <span id="spinner_@subcat.Id" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                                    Salvar Metas Alvo
                                                </button>
                                                <button class="btn btn-sm btn-warning text-dark w-100 mb-2 fw-bold" style="height: 38px;" id="btn_efetivar_@subcat.Id" onclick="solicitarEfetivacaoSubcategoria(@Model.Cenario.Id, @subcat.Id)" title="Submete as metas desta subcategoria para revisão do Administrador">
                                                    <span id="spinner_efetivar_@subcat.Id" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                                    @(Model.Cenario.Status == "PENDENTE_APROVACAO" && !string.IsNullOrEmpty(subcat.Avaliacao?.TierAlvo) ? "Aguardando Aprovação" : "Solicitar Efetivação")
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary w-100" style="height: 38px;" onclick="abrirModalPlanos(@(subcat.Avaliacao?.Id ?? 0), '@subcat.Codigo')">
                                                    Ver Planos de Ação
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                }
                            </div>

                        </div>
                    }
                    
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Planos de Ação -->
<div class="modal fade" id="modalPlanosAcao" tabindex="-1" aria-labelledby="modalPlanosTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalPlanosTitle">Planos de Ação</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalPlanosContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function salvarAlvo(cenarioId, subcategoriaId) {
            const prioridade = document.getElementById(`prioridade_alvo_${subcategoriaId}`).value;
            const tier = document.getElementById(`tier_alvo_${subcategoriaId}`).value;
            const politicas = document.getElementById(`politicas_alvo_${subcategoriaId}`).value;
            const praticas = document.getElementById(`praticas_alvo_${subcategoriaId}`).value;
            const responsabilidades = document.getElementById(`responsabilidades_alvo_${subcategoriaId}`).value;
            const referencias = document.getElementById(`referencias_alvo_${subcategoriaId}`).value;
            
            const spinner = document.getElementById(`spinner_${subcategoriaId}`);
            const badge = document.getElementById(`badge_status_${subcategoriaId}`);
            
            spinner.classList.remove('d-none');

            const payload = {
                CenarioId: cenarioId,
                SubcategoriaId: subcategoriaId,
                PrioridadeAlvo: prioridade,
                TierAlvo: tier,
                PoliticasAlvo: politicas,
                PraticasAlvo: praticas,
                ResponsabilidadesAlvo: responsabilidades,
                ReferenciasAlvo: referencias
            };

            try {
                const response = await fetch('@Url.Action("SalvarAlvo", "Cenario")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (result.success) {
                    badge.innerText = "ALVO DEFINIDO";
                    badge.className = 'badge bg-success';
                    
                    const btn = spinner.parentElement;
                    btn.classList.add('btn-success');
                    btn.classList.remove('btn-cptm');
                    setTimeout(() => {
                        btn.classList.remove('btn-success');
                        btn.classList.add('btn-cptm');
                    }, 1500);
                } else {
                    alert("Erro: " + result.message);
                }
            } catch (error) {
                alert("Falha na comunicação. Verifique a conexão com o servidor.");
            } finally {
                spinner.classList.add('d-none');
            }
        }

        async function solicitarEfetivacaoSubcategoria(cenarioId, subcategoriaId) {
            const prioridade = document.getElementById(`prioridade_alvo_${subcategoriaId}`).value;
            const tier = document.getElementById(`tier_alvo_${subcategoriaId}`).value;
            const politicas = document.getElementById(`politicas_alvo_${subcategoriaId}`).value;
            const praticas = document.getElementById(`praticas_alvo_${subcategoriaId}`).value;
            const responsabilidades = document.getElementById(`responsabilidades_alvo_${subcategoriaId}`).value;
            const referencias = document.getElementById(`referencias_alvo_${subcategoriaId}`).value;

            if (!tier) {
                alert("Por favor, selecione pelo menos o 'Tier CSF Alvo' antes de solicitar a efetivação.");
                return;
            }

            if (!confirm("Deseja submeter as metas desta subcategoria para aprovação da baseline pelo Administrador?")) {
                return;
            }

            const spinner = document.getElementById(`spinner_efetivar_${subcategoriaId}`);
            const badge = document.getElementById(`badge_status_${subcategoriaId}`);
            const btn = document.getElementById(`btn_efetivar_${subcategoriaId}`);
            
            spinner.classList.remove('d-none');

            const payload = {
                CenarioId: cenarioId,
                SubcategoriaId: subcategoriaId,
                PrioridadeAlvo: prioridade,
                TierAlvo: tier,
                PoliticasAlvo: politicas,
                PraticasAlvo: praticas,
                ResponsabilidadesAlvo: responsabilidades,
                ReferenciasAlvo: referencias
            };

            try {
                const response = await fetch('@Url.Action("SolicitarEfetivacaoSubcategoria", "Cenario")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();

                if (result.success) {
                    badge.innerText = "PENDENTE DE APROVAÇÃO";
                    badge.className = 'badge bg-warning text-dark';
                    btn.innerHTML = `<span id="spinner_efetivar_${subcategoriaId}" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>Aguardando Aprovação`;
                    btn.className = 'btn btn-sm btn-outline-warning w-100 mb-2 fw-bold';
                    alert(result.message);
                } else {
                    alert("Atenção: " + result.message);
                }
            } catch (error) {
                alert("Falha na comunicação ao submeter a subcategoria para aprovação.");
            } finally {
                spinner.classList.add('d-none');
            }
        }

        async function efetivarSubcategoria(cenarioId, subcategoriaId) {
            await solicitarEfetivacaoSubcategoria(cenarioId, subcategoriaId);
        }

        async function solicitarAprovacao(cenarioId) {
            if(confirm("Deseja submeter o cenário alvo atual para aprovação?")) {
                const spinner = document.getElementById('btnSubmitSpinner');
                if (spinner) spinner.classList.remove('d-none');
                
                const res = await fetch(`@Url.Action("SubmeterAprovacao", "Cenario")?id=${cenarioId}`, { method: 'POST' });
                const result = await res.json();
                
                if (spinner) spinner.classList.add('d-none');
                
                if (result.success) {
                    alert("Submetido! O Administrador já pode revisá-lo.");
                    window.location.reload();
                } else {
                    alert("Atenção: " + result.message);
                }
            }
        }

        async function abrirModalPlanos(avaliacaoId, codigoSubcat) {
            if (!avaliacaoId || avaliacaoId == 0) {
                alert("Você precisa 'Salvar' as metas desta subcategoria primeiro para adicionar Planos de Ação!");
                return;
            }

            document.getElementById('modalPlanosTitle').innerText = 'Planos de Ação - ' + codigoSubcat;
            const res = await fetch(`@Url.Action("ListarPorAvaliacao", "PlanoAcao")?avaliacaoId=${avaliacaoId}`);
            document.getElementById('modalPlanosContent').innerHTML = await res.text();
            new bootstrap.Modal(document.getElementById('modalPlanosAcao')).show();
        }

        async function recarregarListaPlanos(avaliacaoId) {
            const res = await fetch(`@Url.Action("ListarPorAvaliacao", "PlanoAcao")?avaliacaoId=${avaliacaoId}`);
            document.getElementById('modalPlanosContent').innerHTML = await res.text();
        }

        async function salvarNovoPlano(avaliacaoId) {
            const desc = document.getElementById('novoPlanoDescricao').value;
            const resp = document.getElementById('novoPlanoResp').value;
            const prazo = document.getElementById('novoPlanoPrazo').value;

            if (!desc) { alert("A descrição é obrigatória."); return; }

            const res = await fetch('@Url.Action("Adicionar", "PlanoAcao")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ AvaliacaoId: avaliacaoId, Descricao: desc, Responsavel: resp, Prazo: prazo ? prazo : null })
            });

            if (res.ok) await recarregarListaPlanos(avaliacaoId);
            else alert(await res.text());
        }

        async function alterarStatusPlano(planoId, novoStatus) {
            await fetch(`@Url.Action("AtualizarStatus", "PlanoAcao")?planoId=${planoId}&novoStatus=${novoStatus}`, { method: 'POST' });
        }

        async function excluirPlano(planoId, avaliacaoId) {
            if(confirm("Excluir este plano?")) {
                const res = await fetch(`@Url.Action("Excluir", "PlanoAcao")?planoId=${planoId}`, { method: 'DELETE' });
                if (res.ok) await recarregarListaPlanos(avaliacaoId);
            }
        }
    </script>
}
